<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="simple_room">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="outer_walls">
      <static>true</static>

      <link name="north_wall">
        <pose>0 3.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>6.1 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.1 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_wall">
        <pose>0 -3.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>6.1 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.1 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_wall">
        <pose>3.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.1 6.1 1.0</size></box>
          </geometry>
