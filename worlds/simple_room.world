        <visual name="visual">
          <geometry>
            <box><size>0.1 6.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="west_wall">
        <pose>-3.0 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.1 6.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 6.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>1.5 1.3 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 0.7</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 0.7</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rectangular_obstacle">
      <static>true</static>
      <pose>-1.4 1.3 0.3 0 0 0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 0.4 0.6</size></box>
