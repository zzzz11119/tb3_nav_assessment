#!/usr/bin/env python3
# Copyright 2026 zzr
# SPDX-License-Identifier: Apache-2.0

"""Request and validate a collision-free A* path from Nav2."""

import math
import sys
import time

from action_msgs.msg import GoalStatus
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import ComputePathToPose
from nav_msgs.msg import OccupancyGrid
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy
from rclpy.qos import QoSProfile
from rclpy.qos import ReliabilityPolicy


class AStarSmokeCheck(Node):
    """Check plugin selection, path geometry and occupancy-map safety."""

    def __init__(self):
        super().__init__('astar_smoke_check')
        defaults = {
            'timeout_sec': 20.0,
            'planner_id': 'AStar',
            'start_x': -4.5,
            'start_y': 3.0,
            'goal_x': 4.5,
            'goal_y': 3.0,
            'goal_tolerance': 0.40,
            'occupied_threshold': 65,
            'require_obstacle_detour': True,
        }
        for name, value in defaults.items():
            self.declare_parameter(name, value)

        self.timeout = float(self.get_parameter('timeout_sec').value)
        self.map_message = None
        map_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.map_subscription = self.create_subscription(
            OccupancyGrid, '/map', self._on_map, map_qos
        )
        self.action_client = ActionClient(
            self, ComputePathToPose, 'compute_path_to_pose'
        )

    def _on_map(self, message):
        self.map_message = message

    def _pose(self, x, y):
        pose = PoseStamped()
        pose.header.frame_id = 'map'
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.position.x = float(x)
        pose.pose.position.y = float(y)
        pose.pose.orientation.w = 1.0
        return pose

    def _wait_for_map(self):
        deadline = time.monotonic() + self.timeout
        while self.map_message is None and time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)
        return self.map_message is not None

    def _map_cell(self, x, y):
        grid = self.map_message
        origin = grid.info.origin
        quaternion = origin.orientation
        yaw = math.atan2(
            2.0 * (
                quaternion.w * quaternion.z
                + quaternion.x * quaternion.y
            ),
            1.0 - 2.0 * (
                quaternion.y * quaternion.y
                + quaternion.z * quaternion.z
            ),
        )
        dx = x - origin.position.x
        dy = y - origin.position.y
        local_x = math.cos(yaw) * dx + math.sin(yaw) * dy
        local_y = -math.sin(yaw) * dx + math.cos(yaw) * dy
        mx = math.floor(local_x / grid.info.resolution)
        my = math.floor(local_y / grid.info.resolution)
        if mx < 0 or my < 0 or mx >= grid.info.width or my >= grid.info.height:
            return None
        return int(grid.data[my * grid.info.width + mx])

    def _line_hits_obstacle(self, start, goal):
        distance = math.hypot(goal[0] - start[0], goal[1] - start[1])
        sample_step = max(self.map_message.info.resolution * 0.5, 0.01)
        sample_count = max(2, math.ceil(distance / sample_step))
        occupied_threshold = int(
            self.get_parameter('occupied_threshold').value
        )
        for index in range(sample_count + 1):
            fraction = index / sample_count
            x = start[0] + fraction * (goal[0] - start[0])
            y = start[1] + fraction * (goal[1] - start[1])
            cell = self._map_cell(x, y)
            if cell is not None and cell >= occupied_threshold:
                return True
        return False

    def run(self):
        checks = {}
        checks['map received'] = self._wait_for_map()
        if not checks['map received']:
            return self._report(checks)

        checks['compute_path_to_pose available'] = (
            self.action_client.wait_for_server(timeout_sec=self.timeout)
        )
        if not checks['compute_path_to_pose available']:
            return self._report(checks)

        start = (
            float(self.get_parameter('start_x').value),
            float(self.get_parameter('start_y').value),
        )
        goal = (
            float(self.get_parameter('goal_x').value),
            float(self.get_parameter('goal_y').value),
        )
        request = ComputePathToPose.Goal()
        request.start = self._pose(*start)
        request.goal = self._pose(*goal)
        request.planner_id = str(self.get_parameter('planner_id').value)
        request.use_start = True

        send_future = self.action_client.send_goal_async(request)
        rclpy.spin_until_future_complete(
            self, send_future, timeout_sec=self.timeout
        )
        goal_handle = send_future.result() if send_future.done() else None
        checks['AStar goal accepted'] = bool(
            goal_handle is not None and goal_handle.accepted
        )
        if not checks['AStar goal accepted']:
            return self._report(checks)

        result_future = goal_handle.get_result_async()
        rclpy.spin_until_future_complete(
            self, result_future, timeout_sec=self.timeout
        )
        wrapped_result = (
            result_future.result() if result_future.done() else None
        )
        checks['planning action succeeded'] = bool(
            wrapped_result is not None
            and wrapped_result.status == GoalStatus.STATUS_SUCCEEDED
        )
        if not checks['planning action succeeded']:
            return self._report(checks)

        path = wrapped_result.result.path
        checks['path has at least two poses'] = len(path.poses) >= 2
        if not checks['path has at least two poses']:
            return self._report(checks)

        points = [
            (pose.pose.position.x, pose.pose.position.y)
            for pose in path.poses
        ]
        checks['all path coordinates are finite'] = all(
            math.isfinite(x) and math.isfinite(y) for x, y in points
        )
        checks['path frame is map'] = path.header.frame_id == 'map'
        endpoint_error = math.hypot(
            points[-1][0] - goal[0], points[-1][1] - goal[1]
        )
        checks['endpoint is within tolerance'] = endpoint_error <= float(
            self.get_parameter('goal_tolerance').value
        )

        occupied_threshold = int(
            self.get_parameter('occupied_threshold').value
        )
        path_cells = [self._map_cell(x, y) for x, y in points]
        checks['path stays inside known map'] = all(
            cell is not None and cell >= 0 for cell in path_cells
        )
        checks['path avoids occupied map cells'] = all(
            cell is not None and 0 <= cell < occupied_threshold
            for cell in path_cells
        )

        path_length = sum(
            math.hypot(b[0] - a[0], b[1] - a[1])
            for a, b in zip(points, points[1:])
        )
        straight_length = math.hypot(goal[0] - start[0], goal[1] - start[1])
        if bool(self.get_parameter('require_obstacle_detour').value):
            checks['direct route crosses an obstacle'] = (
                self._line_hits_obstacle(start, goal)
            )
            checks['AStar route makes a real detour'] = (
                path_length > straight_length * 1.05
            )

        self.get_logger().info(
            f'Path poses={len(points)}, length={path_length:.2f} m, '
            f'endpoint error={endpoint_error:.3f} m'
        )
        return self._report(checks)

    def _report(self, checks):
        for label, passed in checks.items():
            logger = self.get_logger().info if passed else self.get_logger().error
            logger(f'[{"PASS" if passed else "FAIL"}] {label}')
        success = bool(checks) and all(checks.values())
        summary = 'PASS' if success else 'FAIL'
        logger = self.get_logger().info if success else self.get_logger().error
        logger(f'A* OPTIONAL CHALLENGE CHECK: {summary}')
        return 0 if success else 1


def main(args=None):
    rclpy.init(args=args)
    node = AStarSmokeCheck()
    try:
        return node.run()
    except KeyboardInterrupt:
        node.get_logger().warning('A* check interrupted.')
        return 130
    except Exception as error:  # Keep acceptance failures shell-friendly.
        node.get_logger().error(f'A* check failed: {error}')
        return 1
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    sys.exit(main())
